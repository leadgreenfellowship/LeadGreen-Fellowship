rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny for anything not explicitly matched below
    match /{document=**} {
      allow read, write: if request.auth != null; 
    }

    // 1. Certificate Payments
    match /certificate_payments/{paymentId} {
      // Anyone can create (submit payment log from checkout)
      allow create: if true;
      // Only authenticated admin can read/update (via Admin portal)
      allow read, update, delete: if request.auth != null;
    }

    // 2. Fellowship Applications
    match /applications/{applicationId} {
      // Anyone can apply (public form)
      allow create: if true;
      // Only authenticated admin can read/update/delete (via Admin Portal)
      allow read, update, delete: if request.auth != null;
    }

    // 3. Alumni Data (for the Alumni Directory)
    match /alumni/{alumniId} {
      // Anyone can read public alumni directory
      allow read: if true;
      // Only authenticated admin can upload/update/delete
      allow write: if request.auth != null;
    }
  }
}
